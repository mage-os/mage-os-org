---
/**
 * Site search dialog. SearchButton opens it, as do Ctrl/Cmd+K and "/". The Pagefind UI and index
 * (built by src/integrations/search.ts) load on first use, so pages that never search pay nothing.
 */
import { Icon } from 'astro-icon/components';
---

<dialog
  id="site-search"
  class="mt-[8vh] mb-auto mx-auto w-[min(44rem,calc(100%-2rem))] max-h-[84vh] overflow-hidden rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-0 text-default shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm"
  aria-labelledby="site-search-title"
  transition:persist
>
  <div class="flex items-center justify-between gap-4 border-b border-gray-200 dark:border-slate-700 px-4 py-3">
    <h2 id="site-search-title" class="text-base font-semibold text-gray-900 dark:text-white">Search mage-os.org</h2>
    <button
      type="button"
      class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg p-2 inline-flex items-center"
      aria-label="Close search"
      data-site-search-close
    >
      <Icon name="tabler:x" class="w-5 h-5" aria-hidden="true" />
    </button>
  </div>
  <div class="max-h-[calc(84vh-3.75rem)] overflow-y-auto p-4" data-site-search-ui>
    <p class="text-sm text-muted dark:text-gray-400" role="status" data-site-search-status>Loading search…</p>
  </div>
</dialog>

<style is:global>
  #site-search {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--aw-color-primary);
    --pagefind-ui-text: var(--aw-color-text-default);
    --pagefind-ui-background: var(--aw-color-bg-page);
    --pagefind-ui-border: rgb(229 231 235);
    --pagefind-ui-tag: rgb(243 244 246);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-font: inherit;
  }

  .dark #site-search {
    --pagefind-ui-border: rgb(51 65 85);
    --pagefind-ui-tag: rgb(30 41 59);
  }

  html:has(#site-search[open]) {
    overflow: hidden;
  }
</style>

<script>
  type PagefindUIConstructor = new (options: Record<string, unknown>) => unknown;

  const BUNDLE_PATH = '/pagefind/';
  let loaded: Promise<void> | undefined;

  const getDialog = () => document.getElementById('site-search') as HTMLDialogElement | null;

  function loadSearchUI(container: HTMLElement): Promise<void> {
    loaded ??= new Promise<void>((resolve, reject) => {
      // The stylesheet goes inside the dialog, which View Transitions keep across page changes.
      const stylesheet = document.createElement('link');
      stylesheet.rel = 'stylesheet';
      stylesheet.href = `${BUNDLE_PATH}pagefind-ui.css`;
      container.before(stylesheet);

      const script = document.createElement('script');
      script.src = `${BUNDLE_PATH}pagefind-ui.js`;
      script.onerror = () => reject(new Error('Pagefind UI failed to load'));
      script.onload = () => {
        const PagefindUI = (window as Window & { PagefindUI?: PagefindUIConstructor }).PagefindUI;
        if (!PagefindUI) return reject(new Error('Pagefind UI is missing'));
        container.replaceChildren();
        new PagefindUI({
          element: container,
          bundlePath: BUNDLE_PATH,
          showSubResults: true,
          showImages: false,
          autofocus: true,
          translations: { placeholder: 'Search pages, guides and posts' },
        });
        resolve();
      };
      document.head.append(script);
    }).catch((error) => {
      loaded = undefined;
      throw error;
    });
    return loaded;
  }

  function openSearch() {
    const dialog = getDialog();
    const container = dialog?.querySelector<HTMLElement>('[data-site-search-ui]');
    if (!dialog || !container || dialog.open) return;

    dialog.showModal();
    loadSearchUI(container)
      .then(() => dialog.querySelector<HTMLInputElement>('input')?.focus())
      .catch(() => {
        const status = dialog.querySelector('[data-site-search-status]');
        if (status) {
          status.textContent = import.meta.env.DEV
            ? 'Search needs the search index, which only the production build creates. Run npm run build, then npm run preview.'
            : 'Search could not be loaded. Please try again later.';
        }
      });
  }

  const isEditable = (target: EventTarget | null) =>
    target instanceof HTMLElement &&
    (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName));

  // Delegated listeners keep working when View Transitions swap the header.
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;
    if (target.closest('[data-site-search-open]')) {
      openSearch();
      return;
    }

    const dialog = getDialog();
    if (!dialog?.open) return;
    // Close on the close button, on a click on the backdrop, and when a result is followed.
    if (
      target === dialog ||
      target.closest('[data-site-search-close]') ||
      target.closest('[data-site-search-ui] a[href]')
    ) {
      dialog.close();
    }
  });

  document.addEventListener('keydown', (event) => {
    const shortcut =
      (event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey)) ||
      (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !isEditable(event.target));
    if (!shortcut || getDialog()?.open) return;
    event.preventDefault();
    openSearch();
  });
</script>
