---
import { Icon } from 'astro-icon/components';

type Project = (typeof import('~/data/lab-modules.json'))['modules'][number] & {
  graduated?: boolean;
  organisation?: string;
};

interface Props {
  module: Project;
  categoryIcon: string;
  qualityStyle: string;
  qualityDescription: string;
}

const { module, categoryIcon, qualityStyle, qualityDescription } = Astro.props;
const status = module.graduated ? 'Graduated' : module.quality.label;
const statusDescription = module.graduated
  ? 'This project has moved from Mage-OS Lab into the main Mage-OS organisation. Its repository signals are shown separately below.'
  : qualityDescription;
const formatDate = (value: string) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(value));
---

<article
  class:list={[
    'group flex min-h-[23rem] min-w-0 flex-col rounded-2xl border bg-white p-5 shadow-sm transition-colors duration-150 hover:border-orange-300 hover:shadow-md dark:bg-slate-800 dark:hover:border-orange-500',
    module.archived ? 'border-slate-300 opacity-80 dark:border-slate-600' : 'border-gray-200 dark:border-slate-700',
  ]}
  data-module-card
  data-slug={module.slug}
  data-graduated={String(Boolean(module.graduated))}
  data-category={module.category}
  data-quality={module.quality.label}
  data-archived={String(module.archived)}
  data-updated={module.sourceUpdatedAt}
  data-score={module.quality.score}
  data-title={module.title}
  data-search={`${module.title} ${module.repository} ${module.summary} ${module.category} ${module.kind} ${module.package ?? ''} ${module.graduated ? 'graduated mage-os' : ''} ${module.contributors.map((contributor) => contributor.login).join(' ')}`.toLowerCase()}
  data-module={JSON.stringify(module)}
  hidden={module.archived || (!module.graduated && module.quality.label === 'Incubating')}
>
  <div class="flex items-start justify-between gap-4">
    <div
      class="group/category relative flex h-11 w-11 shrink-0 cursor-help items-center justify-center rounded-xl bg-orange-50 text-primary outline-none transition-colors duration-200 ease-out hover:bg-primary hover:text-white focus:bg-primary focus:text-white focus:ring-2 focus:ring-primary/30 dark:bg-orange-950/40"
      tabindex="0"
      aria-label={`Category: ${module.category}`}
      aria-describedby={`category-tooltip-${module.slug}`}
    >
      <Icon name={categoryIcon} class="h-6 w-6" />
      <span
        id={`category-tooltip-${module.slug}`}
        role="tooltip"
        class="pointer-events-none invisible absolute left-0 top-full z-30 mt-2 w-max max-w-56 translate-y-1 rounded-lg bg-slate-950 px-3 py-2 text-left text-xs font-semibold text-white opacity-0 shadow-xl transition-[opacity,transform] duration-200 ease-out group-hover/category:visible group-hover/category:translate-y-0 group-hover/category:opacity-100 group-focus/category:visible group-focus/category:translate-y-0 group-focus/category:opacity-100 dark:bg-white dark:text-slate-900"
      >
        {module.category}
      </span>
    </div>
    <div class="flex items-start gap-2">
      <button
        type="button"
        class="group inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gray-200 text-gray-500 transition hover:border-amber-300 hover:bg-amber-50 hover:text-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-400/40 dark:border-slate-600 dark:text-slate-300 dark:hover:border-amber-500 dark:hover:bg-amber-950/40 dark:hover:text-amber-300"
        data-favourite-toggle
        data-favourite-slug={module.slug}
        data-favourite-title={module.title}
        aria-label={`Add ${module.title} to favourites`}
        aria-pressed="false"
        title={`Add ${module.title} to favourites`}
      >
        <Icon name="tabler:star" class="h-4 w-4 group-aria-pressed:hidden" />
        <Icon name="tabler:star-filled" class="hidden h-4 w-4 text-yellow-400 group-aria-pressed:block" />
      </button>
      <span
        class:list={[
          'group/quality relative inline-flex cursor-help items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-bold outline-none focus:ring-2 focus:ring-primary/30',
          module.graduated
            ? 'border-teal-200 bg-teal-50 text-teal-800 dark:border-teal-800 dark:bg-teal-950/40 dark:text-teal-300'
            : qualityStyle,
        ]}
        tabindex="0"
        aria-describedby={`quality-tooltip-${module.slug}`}
      >
        {module.graduated && <Icon name="tabler:school" class="h-3.5 w-3.5" />}
        {status}
        <span
          id={`quality-tooltip-${module.slug}`}
          role="tooltip"
          class="pointer-events-none invisible absolute right-0 top-full z-30 mt-2 w-64 translate-y-1 rounded-lg bg-slate-950 px-3 py-2 text-left text-xs font-medium normal-case leading-5 tracking-normal text-white opacity-0 shadow-xl transition-[opacity,transform] duration-200 ease-out group-hover/quality:visible group-hover/quality:translate-y-0 group-hover/quality:opacity-100 group-focus/quality:visible group-focus/quality:translate-y-0 group-focus/quality:opacity-100 dark:bg-white dark:text-slate-900"
        >
          {statusDescription}
        </span>
      </span>
    </div>
  </div>

  <div class="mt-5 flex-1">
    <h3 class="font-heading text-xl font-bold text-gray-900 dark:text-white">{module.title}</h3>
    <p class="mt-2 line-clamp-3 leading-6 text-muted dark:text-slate-300">{module.summary}</p>
    {
      module.graduated && (
        <a
          href={module.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex min-w-0 max-w-full items-center gap-1.5 text-xs font-semibold text-teal-700 hover:underline dark:text-teal-300"
        >
          <Icon name="tabler:brand-github" class="h-4 w-4 shrink-0" />
          <span class="truncate">mage-os/{module.repository}</span>
          <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5 shrink-0" />
        </a>
      )
    }
    <div class="mt-4 flex items-start gap-2 text-xs text-muted dark:text-slate-400">
      <Icon name="tabler:users" class="mt-0.5 h-4 w-4 shrink-0" />
      <p class="min-w-0">
        <span class="font-bold text-gray-700 dark:text-slate-300">Contributors: </span>
        {
          module.contributors.length ? (
            <>
              {module.contributors
                .slice(0, 3)
                .map((contributor) => contributor.login)
                .join(', ')}
              {module.contributors.length > 3 ? ` +${module.contributors.length - 3}` : ''}
            </>
          ) : (
            'No public contributors listed'
          )
        }
      </p>
    </div>
    <div class="mt-5 rounded-xl bg-gray-50 p-3 dark:bg-slate-900/70">
      <div class="flex items-center justify-between gap-3">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted dark:text-slate-400">Project signals</span
        >
        <span class="text-sm font-bold text-gray-900 dark:text-white"
          >{module.quality.score}/{module.quality.total}</span
        >
      </div>
      <div
        class="mt-2 flex gap-1"
        aria-label={`${module.quality.score} of ${module.quality.total} repository signals present`}
      >
        {
          Array.from({ length: module.quality.total }, (_, index) => (
            <span
              class:list={[
                'h-1.5 flex-1 rounded-full',
                index < module.quality.score ? 'bg-primary' : 'bg-gray-200 dark:bg-slate-700',
              ]}
            />
          ))
        }
      </div>
    </div>
  </div>

  <div class="mt-5 flex items-end justify-between gap-4 border-t border-gray-100 pt-4 dark:border-slate-700">
    <div class="text-xs text-muted dark:text-slate-400">
      <span class="block font-semibold text-gray-700 dark:text-slate-300"
        >Updated {formatDate(module.sourceUpdatedAt)}</span
      >
      {module.latestRelease ? <span>Release {module.latestRelease.tag}</span> : <span>No GitHub release</span>}
    </div>
    <button
      type="button"
      class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 px-3 py-2 text-sm font-bold text-gray-800 transition hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary/30 dark:border-slate-600 dark:text-white"
      data-quick-view
      aria-haspopup="dialog"
    >
      View <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
    </button>
  </div>
</article>

<style>
  [data-module-card][hidden] {
    display: none;
  }
</style>
