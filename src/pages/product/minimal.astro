---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import CodeBlock from '~/components/ui/CodeBlock.astro';
import Callout from '~/components/ui/Callout.astro';
import minimalCorePackages from '~/data/minimal-core-packages.json';

// The Minimal Distribution has no separate repository — it is the metapackage
// mage-os/project-minimal-edition served from the same repo.mage-os.org used
// by the regular Mage-OS release.
const MINIMAL_REPO_URL = 'https://repo.mage-os.org/';

// mage-os/product-minimal-edition is not yet on production repo.mage-os.org
// (it ships from release 3.0.0). It is already published on the preview repo,
// so we derive the minimal set from there at build time. The static
// minimal-core-packages.json is only used as a fallback if the fetch fails.
// TODO: once 3.0.0 is on production, point this at MINIMAL_REPO_URL instead.
const MINIMAL_METAPACKAGE_URL = 'https://preview-repo.mage-os.org/p2/mage-os/product-minimal-edition.json';

interface PkgEntry {
  name: string;
  type: string;
  description: string;
  inMinimal: boolean;
}

// Resolve the minimal core set: prefer the published metapackage's require
// list, fall back to the static JSON snapshot if the preview repo is down.
let minimalSet = new Set<string>(minimalCorePackages);
try {
  const metaData = await fetch(MINIMAL_METAPACKAGE_URL).then((r) => r.json());
  const versions = metaData.packages?.['mage-os/product-minimal-edition'] as Record<string, string>[] | undefined;
  const require = versions?.[0]?.require as Record<string, string> | undefined;
  if (require) {
    const fromMeta = Object.keys(require).filter((k) => k.startsWith('mage-os/'));
    if (fromMeta.length > 0) minimalSet = new Set<string>(fromMeta);
  }
} catch (e) {
  console.warn('[minimal.astro] Failed to fetch minimal metapackage, using static fallback:', e);
}

// Fetch full package list from repo.mage-os.org at build time.
// 1. packages.json tells us the current include file hash.
// 2. include/all$hash.json has every package with type + description.
let packages: PkgEntry[] = [];
try {
  const repoIndex = await fetch('https://repo.mage-os.org/packages.json').then((r) => r.json());
  const includeKey = Object.keys(repoIndex.includes ?? {})[0];
  if (includeKey) {
    const includeData = await fetch(`https://repo.mage-os.org/${includeKey}`).then((r) => r.json());
    packages = Object.entries(includeData.packages as Record<string, object[]>)
      .filter(([name]) => name.startsWith('mage-os/'))
      .map(([name, versions]) => {
        const latest = (Object.values(versions)[0] ?? {}) as Record<string, string>;
        const desc = latest.description ?? '';
        return {
          name,
          type: latest.type ?? '',
          description: desc === 'N/A' ? '' : desc,
          inMinimal: minimalSet.has(name),
        };
      })
      .sort((a, b) => a.name.localeCompare(b.name));
  }
} catch (e) {
  console.warn('[minimal.astro] Failed to fetch packages from repo.mage-os.org:', e);
}

const metadata = {
  title: 'Mage-OS Minimal Distribution | Start Lean, Add What You Need',
  description:
    'Mage-OS Minimal Distribution installs only the essential modules for a functional store. Browse all 400+ available packages you can add via Composer.',
};

const typeCounts: Record<string, number> = {};
for (const pkg of packages) {
  typeCounts[pkg.type] = (typeCounts[pkg.type] ?? 0) + 1;
}

const filterGroups = [
  { label: 'All', value: 'all' },
  { label: `Modules (${typeCounts['magento2-module'] ?? 0})`, value: 'magento2-module' },
  { label: `Themes (${typeCounts['magento2-theme'] ?? 0})`, value: 'magento2-theme' },
  { label: `Languages (${typeCounts['magento2-language'] ?? 0})`, value: 'magento2-language' },
  {
    label: `Libraries (${(typeCounts['magento2-library'] ?? 0) + (typeCounts['library'] ?? 0)})`,
    value: 'library',
  },
  {
    label: `Other (${(typeCounts['metapackage'] ?? 0) + (typeCounts['composer-plugin'] ?? 0) + (typeCounts['magento2-component'] ?? 0)})`,
    value: 'other',
  },
];
---

<Layout metadata={metadata}>
  <PageHero tagline="Mage-OS Distribution" variant="gradient">
    <Fragment slot="title"> Minimal Distribution </Fragment>
    <Fragment slot="subtitle">
      Start with a lean, fully functional store. Every Magento 2 module is available as an individual Composer package —
      install only what your store actually needs.
    </Fragment>
  </PageHero>

  <section class="px-4 py-10 sm:px-6 mx-auto lg:px-8 max-w-5xl">
    <div class="prose dark:prose-invert prose-headings:font-heading prose-headings:font-bold max-w-none">
      <h2>What is the Minimal Distribution?</h2>
      <p>
        The standard Mage-OS Distribution ships with all modules bundled together. The <strong
          >Minimal Distribution</strong
        >
        takes a different approach: it is a metapackage (<code>mage-os/project-minimal-edition</code>) that requires
        only the core packages needed for a working storefront — catalog, checkout, customers, CMS, tax, shipping, and
        the essential framework. Everything else is optional.
      </p>
      <p>
        It is published to the same <code>repo.mage-os.org</code> repository as the regular Mage-OS release — there is no
        separate repository to configure. After installation, you add exactly the functionality your store requires via
        <code>composer require</code>. This means smaller footprints, faster deploys, and no unused code in production.
      </p>

      <h2>Install the Minimal Distribution</h2>
      <Callout type="info" title="Available from Mage-OS 3.0">
        The Minimal Distribution ships with the Mage-OS 3.0 release as a stable Composer package (version 3.0.0 and
        onward). It is still considered an experimental way to install Mage-OS — evaluate it carefully before relying on
        it in production.
      </Callout>
      <CodeBlock
        code={`composer create-project --repository-url=${MINIMAL_REPO_URL} mage-os/project-minimal-edition .`}
        lang="bash"
      />

      <h2>Add packages after installation</h2>
      <p>
        Once your minimal store is running, require any additional package from the table below. All packages are
        available from the same <code>repo.mage-os.org</code> repository:
      </p>
      <CodeBlock
        code={`# Example: add Elasticsearch support
composer require mage-os/module-elasticsearch

# Example: add the Page Builder module
composer require mage-os/module-page-builder`}
        lang="bash"
      />
    </div>
  </section>

  <!-- Package Browser -->
  <!-- TODO: Search is currently a simple client-side name filter. Consider adding
       fuzzy matching or description search if the package list grows significantly. -->
  <section class="px-4 pb-16 sm:px-6 mx-auto lg:px-8 max-w-6xl">
    <div class="mb-6">
      <h2 class="text-2xl font-bold font-heading dark:text-white mb-1">Package Browser</h2>
      <p class="text-muted dark:text-slate-400 text-sm">
        All {packages.length} mage-os packages available in the repository. Packages marked
        <span
          class="inline-block px-1.5 py-0.5 text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900/40 dark:text-orange-300 rounded"
          >Minimal</span
        >
        are included in the base installation.
      </p>
    </div>

    <!-- Controls -->
    <div class="flex flex-col sm:flex-row gap-3 mb-4">
      <input
        id="pkg-search"
        type="search"
        placeholder="Search packages…"
        class="flex-1 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-slate-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary text-sm"
      />
      <label
        id="pkg-minimal-toggle"
        class="flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 text-xs font-medium cursor-pointer select-none whitespace-nowrap transition-colors hover:border-primary hover:text-primary dark:hover:text-primary"
      >
        <input id="pkg-minimal-only" type="checkbox" class="sr-only" />
        <span
          id="pkg-minimal-icon"
          class="w-4 h-4 rounded border border-gray-400 dark:border-gray-500 flex items-center justify-center shrink-0 transition-colors"
        >
          <svg id="pkg-minimal-check" class="hidden w-3 h-3" viewBox="0 0 12 12" fill="none">
            <path
              d="M2 6l3 3 5-5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        Minimal core only
      </label>
    </div>

    <!-- Type filters -->
    <div id="pkg-filters" class="flex flex-wrap gap-2 mb-4">
      {
        filterGroups.map((g) => (
          <button
            data-filter={g.value}
            class={`px-3 py-1.5 rounded-full text-xs font-medium border transition-colors cursor-pointer
            ${
              g.value === 'all'
                ? 'bg-primary text-white border-primary'
                : 'bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 border-gray-300 dark:border-gray-600 hover:border-primary hover:text-primary dark:hover:text-primary'
            }`}
          >
            {g.label}
          </button>
        ))
      }
    </div>

    <!-- Count -->
    <p id="pkg-count" class="text-xs text-muted dark:text-slate-500 mb-3">
      Showing {packages.length} packages
    </p>

    <!-- Table -->
    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
      <table class="w-full text-sm text-left">
        <thead class="text-xs uppercase bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
          <tr>
            <th class="px-4 py-3 font-semibold w-1/2">Package</th>
            <th class="px-4 py-3 font-semibold w-28">Type</th>
            <th class="px-4 py-3 font-semibold">Require command</th>
          </tr>
        </thead>
        <tbody id="pkg-table-body">
          {
            packages.map((pkg) => {
              const shortType = pkg.type.replace('magento2-', '').replace('composer-', '');
              return (
                <tr
                  data-name={pkg.name}
                  data-type={pkg.type}
                  data-minimal={pkg.inMinimal ? '1' : '0'}
                  class="border-t border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-slate-800/50 transition-colors"
                >
                  <td class="px-4 py-3">
                    <div class="flex items-start gap-2">
                      <div>
                        <span class="font-mono text-xs text-gray-900 dark:text-gray-100">{pkg.name}</span>
                        {pkg.description && (
                          <p class="text-xs text-muted dark:text-slate-500 mt-0.5 leading-tight">{pkg.description}</p>
                        )}
                      </div>
                      {pkg.inMinimal && (
                        <span class="shrink-0 inline-block px-1.5 py-0.5 text-xs font-medium bg-orange-100 text-orange-800 dark:bg-orange-900/40 dark:text-orange-300 rounded">
                          Minimal
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <span class="inline-block px-2 py-0.5 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 font-mono">
                      {shortType}
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <code class="text-xs text-gray-700 dark:text-gray-300 font-mono break-all">
                      composer require {pkg.name}
                    </code>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p id="pkg-no-results" class="hidden text-center text-muted dark:text-slate-400 py-10 text-sm">
      No packages match your search.
    </p>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('pkg-search') as HTMLInputElement;
  const minimalCheckbox = document.getElementById('pkg-minimal-only') as HTMLInputElement;
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('#pkg-filters button');
  const rows = document.querySelectorAll<HTMLTableRowElement>('#pkg-table-body tr');
  const countEl = document.getElementById('pkg-count')!;
  const noResultsEl = document.getElementById('pkg-no-results')!;

  let activeType = 'all';

  function applyFilters() {
    const query = searchInput.value.toLowerCase().trim();
    const minimalOnly = minimalCheckbox.checked;
    let visible = 0;

    rows.forEach((row) => {
      const name = row.dataset.name ?? '';
      const type = row.dataset.type ?? '';
      const inMinimal = row.dataset.minimal === '1';

      const matchesSearch = !query || name.includes(query);
      const matchesType =
        activeType === 'all' ||
        (activeType === 'library' && (type === 'magento2-library' || type === 'library')) ||
        (activeType === 'other' &&
          (type === 'metapackage' || type === 'composer-plugin' || type === 'magento2-component')) ||
        type === activeType;
      const matchesMinimal = !minimalOnly || inMinimal;

      const show = matchesSearch && matchesType && matchesMinimal;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    countEl.textContent = `Showing ${visible} package${visible !== 1 ? 's' : ''}`;
    noResultsEl.classList.toggle('hidden', visible > 0);
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeType = btn.dataset.filter ?? 'all';
      filterButtons.forEach((b) => {
        const isActive = b === btn;
        b.classList.toggle('bg-primary', isActive);
        b.classList.toggle('text-white', isActive);
        b.classList.toggle('border-primary', isActive);
        b.classList.toggle('bg-white', !isActive);
        b.classList.toggle('dark:bg-slate-800', !isActive);
        b.classList.toggle('text-gray-700', !isActive);
        b.classList.toggle('dark:text-gray-300', !isActive);
        b.classList.toggle('border-gray-300', !isActive);
        b.classList.toggle('dark:border-gray-600', !isActive);
      });
      applyFilters();
    });
  });

  const minimalToggle = document.getElementById('pkg-minimal-toggle')!;
  const minimalIcon = document.getElementById('pkg-minimal-icon')!;
  const minimalCheckIcon = document.getElementById('pkg-minimal-check')!;

  function updateMinimalToggle() {
    const checked = minimalCheckbox.checked;
    minimalToggle.classList.toggle('bg-orange-50', checked);
    minimalToggle.classList.toggle('dark:bg-orange-900/20', checked);
    minimalToggle.classList.toggle('border-primary', checked);
    minimalToggle.classList.toggle('text-primary', checked);
    minimalToggle.classList.toggle('bg-white', !checked);
    minimalToggle.classList.toggle('dark:bg-slate-800', !checked);
    minimalToggle.classList.toggle('border-gray-300', !checked);
    minimalToggle.classList.toggle('dark:border-gray-600', !checked);
    minimalToggle.classList.toggle('text-gray-700', !checked);
    minimalToggle.classList.toggle('dark:text-gray-300', !checked);
    minimalIcon.classList.toggle('border-primary', checked);
    minimalIcon.classList.toggle('bg-primary', checked);
    minimalIcon.classList.toggle('text-white', checked);
    minimalIcon.classList.toggle('border-gray-400', !checked);
    minimalIcon.classList.toggle('dark:border-gray-500', !checked);
    minimalCheckIcon.classList.toggle('hidden', !checked);
  }

  searchInput.addEventListener('input', applyFilters);
  minimalCheckbox.addEventListener('change', () => {
    updateMinimalToggle();
    applyFilters();
  });
</script>
