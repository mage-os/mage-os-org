---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import catalogue from '~/data/lab-modules.json';

const metadata = {
  title: 'Mage-OS Lab Projects',
  description:
    'Browse Mage-OS Lab modules, themes, tools, and experiments with installation guidance, activity, releases, and transparent repository quality signals.',
};

const modules = [...catalogue.modules].sort(
  (first, second) =>
    Number(first.archived) - Number(second.archived) ||
    new Date(second.sourceUpdatedAt).getTime() - new Date(first.sourceUpdatedAt).getTime()
);
const activeModules = modules.filter((module) => !module.archived);
const archivedModules = modules.filter((module) => module.archived);
const releasedModules = activeModules.filter((module) => module.latestRelease);
const categories = [...new Set(activeModules.map((module) => module.category))].sort();
const qualityLabels = ['Strong signals', 'Developing', 'Experimental', 'Incubating'];

const categoryIcons: Record<string, string> = {
  'Admin & operations': 'tabler:settings-cog',
  'AI & automation': 'tabler:sparkles',
  'Content & merchandising': 'tabler:layout-grid',
  'Developer tools': 'tabler:tools',
  'Performance & runtime': 'tabler:gauge',
  'Security & access': 'tabler:shield-lock',
  'SEO & discovery': 'tabler:world-search',
  Storefront: 'tabler:shopping-bag',
};

const qualityStyles: Record<string, string> = {
  'Strong signals':
    'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300',
  Developing: 'border-blue-200 bg-blue-50 text-blue-800 dark:border-blue-800 dark:bg-blue-950/40 dark:text-blue-300',
  Experimental:
    'border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-300',
  Incubating:
    'border-violet-200 bg-violet-50 text-violet-800 dark:border-violet-800 dark:bg-violet-950/40 dark:text-violet-300',
  Archived: 'border-slate-200 bg-slate-100 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300',
};

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(value));
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden border-b border-gray-200 bg-slate-950 text-white dark:border-slate-800">
    <div class="absolute inset-0 opacity-70" aria-hidden="true">
      <div class="absolute -right-24 -top-40 h-[34rem] w-[34rem] rounded-full bg-orange-500/20 blur-3xl"></div>
      <div class="absolute -bottom-52 left-1/3 h-[30rem] w-[30rem] rounded-full bg-indigo-500/20 blur-3xl"></div>
      <div class="lab-grid absolute inset-0"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24 lg:px-8">
      <div class="max-w-3xl">
        <div
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-sm font-semibold text-orange-200 backdrop-blur"
        >
          <Icon name="tabler:flask-2" class="h-4 w-4" />
          Mage-OS Lab
        </div>
        <h1 class="font-heading text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
          Find the right Lab project.<br /><span class="text-orange-300">Know what you are adopting.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
          Explore community modules, themes, developer tools, and early experiments. Every project includes practical
          usage guidance and transparent signals drawn from its public repository.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#browse-labs"
            class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 font-semibold text-white shadow-lg shadow-orange-950/20 transition hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-300 focus:ring-offset-2 focus:ring-offset-slate-950"
          >
            Browse projects <Icon name="tabler:arrow-down" class="h-4 w-4" />
          </a>
          <a
            href="https://github.com/mage-os-lab"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/5 px-5 py-3 font-semibold text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-950"
          >
            <Icon name="tabler:brand-github" class="h-5 w-5" /> View organisation
          </a>
        </div>
      </div>

      <dl class="mt-12 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
          <dt class="text-sm text-slate-400">Active projects</dt>
          <dd class="mt-1 text-2xl font-bold">{activeModules.length}</dd>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
          <dt class="text-sm text-slate-400">With releases</dt>
          <dd class="mt-1 text-2xl font-bold">{releasedModules.length}</dd>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
          <dt class="text-sm text-slate-400">Categories</dt>
          <dd class="mt-1 text-2xl font-bold">{categories.length}</dd>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
          <dt class="text-sm text-slate-400">Last checked</dt>
          <dd class="mt-1 text-base font-bold">{formatDate(catalogue.catalogueUpdatedAt)}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="browse-labs" class="scroll-mt-24 bg-gray-50 py-14 dark:bg-slate-900 sm:py-20" data-labs-page>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-widest text-primary">Project catalogue</p>
          <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
            Browse the Lab
          </h2>
          <p class="mt-3 text-muted dark:text-slate-300">
            Archived projects are hidden by default. Use quick view for installation, compatibility, caveats, and the
            evidence behind each readiness label.
          </p>
        </div>
        <p class="text-sm text-muted dark:text-slate-400" aria-live="polite">
          Showing <strong class="text-gray-900 dark:text-white" data-result-count>{activeModules.length}</strong> projects
        </p>
      </div>

      <div
        class="mt-8 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-5"
      >
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-12">
          <label class="lg:col-span-4">
            <span class="mb-1.5 block text-sm font-semibold text-gray-800 dark:text-slate-200">Search projects</span>
            <span class="relative block">
              <Icon
                name="tabler:search"
                class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400"
              />
              <input
                type="search"
                placeholder="Name, purpose, package…"
                class="w-full rounded-lg border border-gray-300 bg-white py-2.5 pl-10 pr-3 text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
                data-filter-search
              />
            </span>
          </label>

          <label class="lg:col-span-3">
            <span class="mb-1.5 block text-sm font-semibold text-gray-800 dark:text-slate-200">Category</span>
            <select
              class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-gray-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
              data-filter-category
            >
              <option value="">All categories</option>
              {categories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </label>

          <label class="lg:col-span-3">
            <span class="mb-1.5 block text-sm font-semibold text-gray-800 dark:text-slate-200">Readiness</span>
            <select
              class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-gray-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
              data-filter-quality
            >
              <option value="">All readiness levels</option>
              {qualityLabels.map((label) => <option value={label}>{label}</option>)}
              <option value="Archived">Archived</option>
            </select>
          </label>

          <label class="lg:col-span-2">
            <span class="mb-1.5 block text-sm font-semibold text-gray-800 dark:text-slate-200">Sort</span>
            <select
              class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-gray-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
              data-filter-sort
            >
              <option value="updated">Recently updated</option>
              <option value="quality">Most signals</option>
              <option value="name">Name A–Z</option>
            </select>
          </label>
        </div>

        <div
          class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-gray-100 pt-4 dark:border-slate-700"
        >
          <label
            class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700 dark:text-slate-300"
          >
            <input
              type="checkbox"
              class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary"
              data-filter-archived
            />
            Show archived projects <span class="text-muted">({archivedModules.length})</span>
          </label>
          <button type="button" class="text-sm font-semibold text-primary hover:underline" data-filter-clear
            >Clear filters</button
          >
        </div>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-module-grid>
        {
          modules.map((module) => (
            <article
              class:list={[
                'group flex min-h-[23rem] flex-col rounded-2xl border bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg dark:bg-slate-800',
                module.archived
                  ? 'border-slate-300 opacity-80 dark:border-slate-600'
                  : 'border-gray-200 dark:border-slate-700',
              ]}
              data-module-card
              data-slug={module.slug}
              data-category={module.category}
              data-quality={module.quality.label}
              data-archived={String(module.archived)}
              data-updated={module.sourceUpdatedAt}
              data-score={module.quality.score}
              data-title={module.title}
              data-search={`${module.title} ${module.repository} ${module.summary} ${module.category} ${module.kind} ${module.package ?? ''}`.toLowerCase()}
              data-module={JSON.stringify(module)}
              hidden={module.archived}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-orange-50 text-primary transition group-hover:bg-primary group-hover:text-white dark:bg-orange-950/40">
                  <Icon name={categoryIcons[module.category] ?? 'tabler:flask'} class="h-6 w-6" />
                </div>
                <span
                  class:list={[
                    'rounded-full border px-2.5 py-1 text-xs font-bold',
                    qualityStyles[module.quality.label],
                  ]}
                >
                  {module.quality.label}
                </span>
              </div>

              <div class="mt-5 flex-1">
                <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted dark:text-slate-400">
                  <>
                    <span>{module.category}</span>
                    <span aria-hidden="true">·</span>
                    <span>{module.kind}</span>
                  </>
                </div>
                <h3 class="mt-2 font-heading text-xl font-bold text-gray-900 dark:text-white">{module.title}</h3>
                <p class="mt-2 line-clamp-3 leading-6 text-muted dark:text-slate-300">{module.summary}</p>

                <div class="mt-5 rounded-xl bg-gray-50 p-3 dark:bg-slate-900/70">
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-xs font-semibold uppercase tracking-wide text-muted dark:text-slate-400">
                      Quality signals
                    </span>
                    <span class="text-sm font-bold text-gray-900 dark:text-white">
                      {module.quality.score}/{module.quality.total}
                    </span>
                  </div>
                  <div
                    class="mt-2 flex gap-1"
                    aria-label={`${module.quality.score} of ${module.quality.total} repository signals present`}
                  >
                    {Array.from({ length: module.quality.total }, (_, index) => (
                      <span
                        class:list={[
                          'h-1.5 flex-1 rounded-full',
                          index < module.quality.score ? 'bg-primary' : 'bg-gray-200 dark:bg-slate-700',
                        ]}
                      />
                    ))}
                  </div>
                </div>
              </div>

              <div class="mt-5 flex items-end justify-between gap-4 border-t border-gray-100 pt-4 dark:border-slate-700">
                <div class="text-xs text-muted dark:text-slate-400">
                  <span class="block font-semibold text-gray-700 dark:text-slate-300">
                    Updated {formatDate(module.sourceUpdatedAt)}
                  </span>
                  {module.latestRelease ? (
                    <span>Release {module.latestRelease.tag}</span>
                  ) : (
                    <span>No GitHub release</span>
                  )}
                </div>
                <button
                  type="button"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 px-3 py-2 text-sm font-bold text-gray-800 transition hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary/30 dark:border-slate-600 dark:text-white"
                  data-quick-view
                  aria-haspopup="dialog"
                >
                  Quick view <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
                </button>
              </div>
            </article>
          ))
        }
      </div>

      <div
        class="mt-8 hidden rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-14 text-center dark:border-slate-700 dark:bg-slate-800"
        data-no-results
      >
        <Icon name="tabler:filter-off" class="mx-auto h-10 w-10 text-gray-400" />
        <h3 class="mt-3 text-lg font-bold text-gray-900 dark:text-white">No matching projects</h3>
        <p class="mt-1 text-muted dark:text-slate-400">Try a different search or clear the filters.</p>
      </div>
    </div>
  </section>

  <section
    id="quality-scope"
    class="border-y border-gray-200 bg-white py-14 dark:border-slate-800 dark:bg-slate-950 sm:py-20"
  >
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-primary">How to read the scope</p>
        <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
          Evidence, not a seal of approval
        </h2>
        <p class="mt-4 leading-7 text-muted dark:text-slate-300">
          The readiness label summarizes six facts visible in the public repository. It helps you decide what to inspect
          next; it is not a security audit, support promise, or production certification.
        </p>
        <p class="mt-4 text-sm text-muted dark:text-slate-400">
          Repository data checked <strong class="text-gray-900 dark:text-white"
            >{formatDate(catalogue.catalogueUpdatedAt)}</strong
          >. Each card also shows the date its source repository was last pushed.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        {
          catalogue.methodology.signals.map((signal, index) => (
            <div class="flex gap-3 rounded-xl border border-gray-200 bg-gray-50 p-4 dark:border-slate-700 dark:bg-slate-900">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-primary dark:bg-orange-950/50">
                {index + 1}
              </span>
              <div>
                <h3 class="font-bold text-gray-900 dark:text-white">{signal}</h3>
                <p class="mt-1 text-sm text-muted dark:text-slate-400">
                  {
                    [
                      'The README explains installation or practical usage.',
                      'A package, release binary, or documented install path exists.',
                      'The repository has a published GitHub release.',
                      'A test suite or documented test command is present.',
                      'Repository workflows run automated checks or builds.',
                      'Code was pushed within 180 days of the catalogue check.',
                    ][index]
                  }
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-gradient-to-br from-orange-500 to-orange-600 py-14 text-white sm:py-16">
    <div class="mx-auto flex max-w-5xl flex-col items-center px-4 text-center sm:px-6">
      <Icon name="tabler:git-pull-request" class="h-10 w-10" />
      <h2 class="mt-4 font-heading text-3xl font-bold">Help a Lab project grow up</h2>
      <p class="mt-3 max-w-2xl text-lg text-orange-50">
        Try a project, improve its docs, add tests, report a reproducible issue, or contribute the missing feature.
      </p>
      <a
        href="https://github.com/mage-os-lab"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 font-bold text-orange-700 shadow-lg transition hover:bg-orange-50 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-orange-600"
      >
        Explore on GitHub <Icon name="tabler:external-link" class="h-4 w-4" />
      </a>
    </div>
  </section>

  <dialog
    class="m-auto max-h-[90vh] w-[calc(100%-2rem)] max-w-3xl overflow-hidden rounded-2xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-slate-950/70 backdrop:backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900 dark:text-white"
    data-quick-dialog
    aria-labelledby="lab-dialog-title"
  >
    <div class="max-h-[90vh] overflow-y-auto">
      <header
        class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-gray-200 bg-white/95 p-5 backdrop-blur dark:border-slate-700 dark:bg-slate-900/95 sm:p-6"
      >
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-primary" data-dialog-category></span>
            <span class="text-xs text-muted dark:text-slate-400" data-dialog-kind></span>
          </div>
          <h2 id="lab-dialog-title" class="mt-1 font-heading text-2xl font-bold" data-dialog-title></h2>
        </div>
        <form method="dialog">
          <button
            type="submit"
            class="rounded-lg p-2 text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary dark:hover:bg-slate-800 dark:hover:text-white"
            aria-label="Close quick view"
          >
            <Icon name="tabler:x" class="h-5 w-5" />
          </button>
        </form>
      </header>

      <div class="space-y-7 p-5 sm:p-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border px-2.5 py-1 text-xs font-bold" data-dialog-quality></span>
          <span class="text-sm font-semibold text-muted dark:text-slate-400" data-dialog-score></span>
        </div>

        <p class="text-base leading-7 text-gray-700 dark:text-slate-300" data-dialog-summary></p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl bg-gray-50 p-4 dark:bg-slate-800">
            <h3 class="text-sm font-bold uppercase tracking-wide text-gray-500 dark:text-slate-400">How to use it</h3>
            <p class="mt-2 leading-6 text-gray-800 dark:text-slate-200" data-dialog-usage></p>
          </div>
          <div class="rounded-xl bg-gray-50 p-4 dark:bg-slate-800">
            <h3 class="text-sm font-bold uppercase tracking-wide text-gray-500 dark:text-slate-400">Requirements</h3>
            <p class="mt-2 leading-6 text-gray-800 dark:text-slate-200" data-dialog-requirements></p>
          </div>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between gap-3">
            <h3 class="font-bold">Install or get started</h3>
            <button type="button" class="text-sm font-bold text-primary hover:underline" data-copy-install>Copy</button>
          </div>
          <pre
            class="overflow-x-auto rounded-xl bg-slate-950 p-4 text-sm leading-6 text-slate-100"><code data-dialog-install /></pre>
        </div>

        <div
          class="hidden rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-900 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-200"
          data-dialog-caveat-wrapper
        >
          <div class="flex gap-3">
            <Icon name="tabler:alert-triangle" class="mt-0.5 h-5 w-5 shrink-0" />
            <div>
              <h3 class="font-bold">Worth knowing</h3>
              <p class="mt-1 text-sm leading-6" data-dialog-caveat></p>
            </div>
          </div>
        </div>

        <div>
          <h3 class="font-bold">Repository quality signals</h3>
          <div class="mt-3 grid gap-2 sm:grid-cols-2" data-dialog-signals></div>
          <p class="mt-3 text-xs text-muted dark:text-slate-400">
            These are repository signals, not a security or production-readiness certification.
          </p>
        </div>

        <dl
          class="grid grid-cols-2 gap-x-4 gap-y-4 border-t border-gray-200 pt-5 text-sm dark:border-slate-700 sm:grid-cols-4"
        >
          <div>
            <dt class="text-muted dark:text-slate-400">Last push</dt><dd class="mt-1 font-bold" data-dialog-updated>
            </dd>
          </div>
          <div>
            <dt class="text-muted dark:text-slate-400">Last checked</dt><dd class="mt-1 font-bold" data-dialog-checked>
            </dd>
          </div>
          <div>
            <dt class="text-muted dark:text-slate-400">Release</dt><dd class="mt-1 font-bold" data-dialog-release></dd>
          </div>
          <div>
            <dt class="text-muted dark:text-slate-400">License</dt><dd class="mt-1 font-bold" data-dialog-license></dd>
          </div>
          <div>
            <dt class="text-muted dark:text-slate-400">Stars</dt><dd class="mt-1 font-bold" data-dialog-stars></dd>
          </div>
          <div>
            <dt class="text-muted dark:text-slate-400">Forks</dt><dd class="mt-1 font-bold" data-dialog-forks></dd>
          </div>
          <div>
            <dt class="text-muted dark:text-slate-400">Open issues</dt><dd class="mt-1 font-bold" data-dialog-issues>
            </dd>
          </div>
          <div>
            <dt class="text-muted dark:text-slate-400">Language</dt><dd class="mt-1 font-bold" data-dialog-language>
            </dd>
          </div>
        </dl>

        <div class="flex flex-col gap-3 border-t border-gray-200 pt-5 dark:border-slate-700 sm:flex-row sm:justify-end">
          <a
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 px-4 py-2.5 font-bold transition hover:border-primary hover:text-primary dark:border-slate-600"
            target="_blank"
            rel="noopener noreferrer"
            data-dialog-issues-link
          >
            View issues <Icon name="tabler:circle-dot" class="h-4 w-4" />
          </a>
          <a
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 font-bold text-white transition hover:bg-orange-600"
            target="_blank"
            rel="noopener noreferrer"
            data-dialog-repository-link
          >
            Open repository <Icon name="tabler:brand-github" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  type LabModule = (typeof import('~/data/lab-modules.json'))['modules'][number];

  const signalLabels: Record<keyof LabModule['quality']['signals'], string> = {
    documentation: 'Usage documentation',
    installable: 'Installable',
    release: 'Published release',
    tests: 'Tests',
    automation: 'Automated checks',
    recentActivity: 'Recent activity',
  };

  const qualityClasses: Record<string, string[]> = {
    'Strong signals': [
      'border-emerald-200',
      'bg-emerald-50',
      'text-emerald-800',
      'dark:border-emerald-800',
      'dark:bg-emerald-950/40',
      'dark:text-emerald-300',
    ],
    Developing: [
      'border-blue-200',
      'bg-blue-50',
      'text-blue-800',
      'dark:border-blue-800',
      'dark:bg-blue-950/40',
      'dark:text-blue-300',
    ],
    Experimental: [
      'border-amber-200',
      'bg-amber-50',
      'text-amber-800',
      'dark:border-amber-800',
      'dark:bg-amber-950/40',
      'dark:text-amber-300',
    ],
    Incubating: [
      'border-violet-200',
      'bg-violet-50',
      'text-violet-800',
      'dark:border-violet-800',
      'dark:bg-violet-950/40',
      'dark:text-violet-300',
    ],
    Archived: [
      'border-slate-200',
      'bg-slate-100',
      'text-slate-700',
      'dark:border-slate-700',
      'dark:bg-slate-800',
      'dark:text-slate-300',
    ],
  };

  const formatDialogDate = (value: string) =>
    new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(value));

  const setText = (root: ParentNode, selector: string, value: string | number) => {
    const element = root.querySelector<HTMLElement>(selector);
    if (element) element.textContent = String(value);
  };

  function initLabsPage() {
    const page = document.querySelector<HTMLElement>('[data-labs-page]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-quick-dialog]');
    if (!page || !dialog || page.dataset.labsReady === 'true') return;
    page.dataset.labsReady = 'true';

    const search = page.querySelector<HTMLInputElement>('[data-filter-search]');
    const category = page.querySelector<HTMLSelectElement>('[data-filter-category]');
    const quality = page.querySelector<HTMLSelectElement>('[data-filter-quality]');
    const sort = page.querySelector<HTMLSelectElement>('[data-filter-sort]');
    const archived = page.querySelector<HTMLInputElement>('[data-filter-archived]');
    const clear = page.querySelector<HTMLButtonElement>('[data-filter-clear]');
    const grid = page.querySelector<HTMLElement>('[data-module-grid]');
    const count = page.querySelector<HTMLElement>('[data-result-count]');
    const noResults = page.querySelector<HTMLElement>('[data-no-results]');
    const cards = [...page.querySelectorAll<HTMLElement>('[data-module-card]')];
    if (!search || !category || !quality || !sort || !archived || !clear || !grid || !count || !noResults) return;

    const parameters = new URLSearchParams(window.location.search);
    search.value = parameters.get('q') ?? '';
    category.value = parameters.get('category') ?? '';
    quality.value = parameters.get('readiness') ?? '';
    sort.value = parameters.get('sort') ?? 'updated';
    archived.checked = parameters.get('archived') === '1' || quality.value === 'Archived';

    const applyFilters = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const matchesSearch = !query || card.dataset.search?.includes(query);
        const matchesCategory = !category.value || card.dataset.category === category.value;
        const matchesQuality = !quality.value || card.dataset.quality === quality.value;
        const matchesArchive = archived.checked || card.dataset.archived !== 'true';
        card.hidden = !(matchesSearch && matchesCategory && matchesQuality && matchesArchive);
        if (!card.hidden) visible += 1;
      }

      const sortedCards = [...cards].sort((first, second) => {
        if (sort.value === 'name') return (first.dataset.title ?? '').localeCompare(second.dataset.title ?? '');
        if (sort.value === 'quality')
          return (
            Number(second.dataset.score) - Number(first.dataset.score) ||
            (first.dataset.title ?? '').localeCompare(second.dataset.title ?? '')
          );
        return new Date(second.dataset.updated ?? '').getTime() - new Date(first.dataset.updated ?? '').getTime();
      });
      for (const card of sortedCards) grid.append(card);

      count.textContent = String(visible);
      noResults.classList.toggle('hidden', visible !== 0);

      const nextParameters = new URLSearchParams(window.location.search);
      for (const key of ['q', 'category', 'readiness', 'sort', 'archived']) nextParameters.delete(key);
      if (search.value.trim()) nextParameters.set('q', search.value.trim());
      if (category.value) nextParameters.set('category', category.value);
      if (quality.value) nextParameters.set('readiness', quality.value);
      if (sort.value !== 'updated') nextParameters.set('sort', sort.value);
      if (archived.checked) nextParameters.set('archived', '1');
      const nextQuery = nextParameters.toString();
      window.history.replaceState(
        {},
        '',
        `${window.location.pathname}${nextQuery ? `?${nextQuery}` : ''}${window.location.hash}`
      );
    };

    const openDialog = (module: LabModule) => {
      setText(dialog, '[data-dialog-category]', module.category);
      setText(dialog, '[data-dialog-kind]', `· ${module.kind}`);
      setText(dialog, '[data-dialog-title]', module.title);
      setText(dialog, '[data-dialog-summary]', module.summary);
      setText(dialog, '[data-dialog-usage]', module.howToUse);
      setText(dialog, '[data-dialog-requirements]', module.requirements);
      setText(dialog, '[data-dialog-install]', module.install);
      setText(dialog, '[data-dialog-score]', `${module.quality.score}/${module.quality.total} signals present`);
      setText(dialog, '[data-dialog-updated]', formatDialogDate(module.sourceUpdatedAt));
      setText(dialog, '[data-dialog-checked]', formatDialogDate(module.dataCheckedAt));
      setText(dialog, '[data-dialog-release]', module.latestRelease?.tag ?? 'None');
      setText(dialog, '[data-dialog-license]', module.license ?? 'Not stated');
      setText(dialog, '[data-dialog-stars]', module.stars);
      setText(dialog, '[data-dialog-forks]', module.forks);
      setText(dialog, '[data-dialog-issues]', module.openIssues);
      setText(dialog, '[data-dialog-language]', module.language ?? '—');

      const qualityBadge = dialog.querySelector<HTMLElement>('[data-dialog-quality]');
      if (qualityBadge) {
        qualityBadge.className = 'rounded-full border px-2.5 py-1 text-xs font-bold';
        qualityBadge.classList.add(...(qualityClasses[module.quality.label] ?? qualityClasses.Incubating));
        qualityBadge.textContent = module.quality.label;
      }

      const caveatWrapper = dialog.querySelector<HTMLElement>('[data-dialog-caveat-wrapper]');
      if (caveatWrapper) {
        caveatWrapper.classList.toggle('hidden', !module.caveat);
        setText(caveatWrapper, '[data-dialog-caveat]', module.caveat ?? '');
      }

      const signals = dialog.querySelector<HTMLElement>('[data-dialog-signals]');
      if (signals) {
        signals.replaceChildren();
        for (const [key, present] of Object.entries(module.quality.signals) as [
          keyof LabModule['quality']['signals'],
          boolean,
        ][]) {
          const item = document.createElement('div');
          item.className = `flex items-center gap-2 rounded-lg border px-3 py-2 text-sm font-semibold ${
            present
              ? 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300'
              : 'border-gray-200 bg-gray-50 text-gray-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400'
          }`;
          item.innerHTML = `<span aria-hidden="true">${present ? '✓' : '—'}</span><span>${signalLabels[key]}</span>`;
          signals.append(item);
        }
      }

      const repositoryLink = dialog.querySelector<HTMLAnchorElement>('[data-dialog-repository-link]');
      const issuesLink = dialog.querySelector<HTMLAnchorElement>('[data-dialog-issues-link]');
      if (repositoryLink) repositoryLink.href = module.url;
      if (issuesLink) issuesLink.href = module.issuesUrl;

      const copyButton = dialog.querySelector<HTMLButtonElement>('[data-copy-install]');
      if (copyButton) {
        copyButton.textContent = 'Copy';
        copyButton.onclick = async () => {
          await navigator.clipboard.writeText(module.install);
          copyButton.textContent = 'Copied';
          window.setTimeout(() => (copyButton.textContent = 'Copy'), 1600);
        };
      }

      if (!dialog.open) dialog.showModal();
      const nextParameters = new URLSearchParams(window.location.search);
      nextParameters.set('project', module.slug);
      window.history.replaceState(
        {},
        '',
        `${window.location.pathname}?${nextParameters.toString()}${window.location.hash}`
      );
    };

    for (const card of cards) {
      const quickView = card.querySelector<HTMLButtonElement>('[data-quick-view]');
      quickView?.addEventListener('click', () => {
        if (card.dataset.module) openDialog(JSON.parse(card.dataset.module) as LabModule);
      });
    }

    for (const input of [search, category, sort, archived]) {
      input.addEventListener(input === search ? 'input' : 'change', applyFilters);
    }

    quality.addEventListener('change', () => {
      if (quality.value === 'Archived') archived.checked = true;
      applyFilters();
    });

    clear.addEventListener('click', () => {
      search.value = '';
      category.value = '';
      quality.value = '';
      sort.value = 'updated';
      archived.checked = false;
      applyFilters();
      search.focus();
    });

    dialog.addEventListener('close', () => {
      const nextParameters = new URLSearchParams(window.location.search);
      nextParameters.delete('project');
      const nextQuery = nextParameters.toString();
      window.history.replaceState(
        {},
        '',
        `${window.location.pathname}${nextQuery ? `?${nextQuery}` : ''}${window.location.hash}`
      );
    });

    dialog.addEventListener('click', (event) => {
      const bounds = dialog.getBoundingClientRect();
      const outside =
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom;
      if (outside) dialog.close();
    });

    applyFilters();
    const requestedProject = parameters.get('project');
    const requestedCard = requestedProject ? cards.find((card) => card.dataset.slug === requestedProject) : undefined;
    if (requestedCard?.dataset.module) openDialog(JSON.parse(requestedCard.dataset.module) as LabModule);
  }

  document.addEventListener('astro:page-load', initLabsPage);
  initLabsPage();
</script>

<style>
  .lab-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to right, transparent, black 45%, black);
  }

  [data-module-card][hidden] {
    display: none;
  }

  dialog:not([open]) {
    display: none;
  }
</style>
